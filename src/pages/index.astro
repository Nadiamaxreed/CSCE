---
import Base from '../layouts/Base.astro';
import Brands from '../components/Brands.astro';
import Media from '../components/Media.astro';
import {event,categories,faqs} from '../data/event';
import news from '../data/news.json';
const latestNews = [...news.exhibition].sort((a,b)=>b.date.localeCompare(a.date)).slice(0,4);
---
<Base title="2027第13届济南餐博会官网｜5月13—15日·山东国际会展中心" description="海名·2027第13届济南餐博会，5月13—15日在山东国际会展中心举办。查看九大展品范围、参展参观指引与交通信息，展位预订直接联系客服。">
<section class="hero"><div class="hero-lines" aria-hidden="true"></div><div class="wrap hero-grid"><div class="hero-copy"><span class="eyebrow">HAIMING · JINAN CATERING EXPO 2027</span><p class="edition">海名·2027第13届济南餐博会</p><h1>好生意，<br/>从<span>好食材</span>开始。</h1><p class="hero-intro">立足山东，链接北方餐饮市场。<br/>来济南，寻找下一道招牌菜与下一位生意伙伴。</p><div class="hero-actions"><a class="button lime" href="/exhibit/">我要参展 ↗</a><a class="button outline" href={event.registration} target="_blank" rel="noopener noreferrer">参观登记 ↗</a></div><div class="hero-date"><strong>2027.05.13—15</strong><span>山东国际会展中心 · 济南</span></div></div><div class="hero-art"><span class="vertical-note">DISCOVER · TASTE · CONNECT</span><figure><img src="/images/scene-2.webp" alt="往届济南餐博会展位洽谈与食材展示现场" width="1800" height="1202" fetchpriority="high"/><figcaption>往届现场 · 面对面，发现合作的可能</figcaption></figure><div class="date-stamp"><b>05</b><span>MAY<br/>13—15</span></div><span class="art-caption">食材 × 味道 × 生意</span></div></div><div class="hero-bottom wrap"><span>一站式探索餐饮供应链</span><span>食材 / 调味 / 饮品 / 设备 / 包装</span><a href="#explore">向下探索 ↓</a></div></section>
<section class="quick wrap" aria-label="快捷服务"><a href="/categories/"><span>01 / 找产品</span><b>按品类，找到采购方向</b><i>↗</i></a><a href="/exhibit/"><span>02 / 拓市场</span><b>展位预订，直接对话客服</b><i>↗</i></a><a href="/travel/"><span>03 / 来济南</span><b>轻松规划您的逛展路线</b><i>↗</i></a></section>
<section class="section wrap intro" id="explore"><div><span class="eyebrow green">ABOUT THE EXPO</span><h2>扎根餐饮大省，<br/>遇见供应链新机会。</h2><a class="text-link" href="/about/">认识济南餐博会 ↗</a></div><div><p class="lead">从源头食材到后厨配套，<br/>把选品、交流与合作放在同一现场。</p><p>海名·济南餐博会立足山东餐饮市场，为餐饮企业、食材供应商与渠道伙伴提供面对面的交流平台。2027第13届展会将于5月13—15日在山东国际会展中心举办。</p><div class="intro-facts"><div><b>13<span>届</span></b><small>2027届次</small></div><div><b>9<span>类</span></b><small>展品方向</small></div><div><b>3<span>天</span></b><small>展期安排</small></div></div></div></section>
<section class="section category-section"><div class="wrap"><div class="section-head"><div><span class="eyebrow green">EXPLORE THE SUPPLY CHAIN</span><h2>从一份采购清单，<br/>到更多生意可能。</h2></div><a class="text-link" href="/categories/">查看完整展品范围 ↗</a></div><div class="category-grid">{categories.map(([name,tag],i)=><a class="category" href={'/categories/#category-'+(i+1)}><span class="category-no">{String(i+1).padStart(2,'0')}</span><h3>{name}</h3><p>{tag}</p><span class="category-arrow">↗</span></a>)}</div><p class="note">展品范围沿用原官网分类整理；实际参展产品以现场及组委会公布为准。</p></div></section>
<Brands/><section class="section wrap dual"><div class="service dark"><span class="eyebrow">FOR EXHIBITORS</span><h2>把您的好产品，<br/>带到采购商面前。</h2><p>了解展位、沟通位置、确认参展事项。<br/>客服协助您安排参展下一步。</p><a class="button lime" href="/contact/">展位预订 · 联系客服 ↗</a><a class="sub-link" href="/exhibit/">查看参展流程 →</a></div><div class="service light"><span class="eyebrow green">FOR VISITORS</span><h2>带着需求来，<br/>带着新选择回去。</h2><p>餐饮选品、渠道采购、后厨升级。<br/>先明确采购目标，再规划高效逛展路线。</p><a class="button green-button" href={event.registration} target="_blank" rel="noopener noreferrer">参观登记 ↗</a><a class="sub-link" href="/visit/">查看参观指南 →</a><a class="sub-link" href="/travel/">如何抵达展馆 →</a></div></section>
<section class="section wrap"><div class="section-head"><div><span class="eyebrow green">MOMENTS THAT CONNECT</span><h2>面对面的热度，<br/>是合作的开始。</h2></div><a class="text-link" href="/review/">走进往届现场 ↗</a></div><div class="gallery"><figure><img src="/images/scene-2.webp" alt="往届现场：展台产品展示与采购交流" width="1800" height="1202" loading="lazy"/><figcaption>往届现场 / 食材展示与采购交流</figcaption></figure><figure><img src="/images/scene-1.webp" alt="往届现场：鲁菜美食文化交流活动" width="1800" height="1197" loading="lazy"/><figcaption>往届现场 / 鲁菜文化与行业交流</figcaption></figure></div></section>
<section class="section wrap" id="latest-news" aria-labelledby="latest-news-title"><div class="section-head"><div><span class="eyebrow green">LATEST NEWS</span><h2 id="latest-news-title">展会新闻</h2></div><a class="text-link" href="/news/">查看全部新闻 ↗</a></div><div class="home-news-list">{latestNews.map(item=><a class="home-news-item" href={item.url} target={item.url.startsWith('http')?'_blank':undefined} rel={item.url.startsWith('http')?'noopener noreferrer':undefined}><time datetime={item.date}>{item.date.replaceAll('-','.')}</time><h3>{item.title}</h3><span class="home-news-arrow" aria-hidden="true">↗</span></a>)}</div></section><Media/><section class="section faq-section"><div class="wrap faq-layout"><div><span class="eyebrow green">BEFORE YOUR VISIT</span><h2>出发前，<br/>您可能想了解。</h2><a class="text-link" href="/contact/">联系组委会 ↗</a></div><div>{faqs.map(([q,a])=><details><summary>{q}</summary><p>{a}</p></details>)}</div></div></section>
</Base>
