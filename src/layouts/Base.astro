---
import '../styles/global.css';
import {event,nav} from '../data/event';
interface Props {title: string; description: string;}
const {title,description}=Astro.props;
const path=Astro.url.pathname;
const canonical=new URL(path,event.site).href;
const graph=[{'@type':'Organization','@id':event.site+'/#organization',name:event.company,url:event.site,telephone:event.phone},{'@type':'Event','@id':event.site+'/#event',name:event.name,startDate:event.start,endDate:event.end,eventStatus:'https://schema.org/EventScheduled',eventAttendanceMode:'https://schema.org/OfflineEventAttendanceMode',url:event.site,description:'餐饮供应链专业展会，涵盖食材、调味品、饮品及厨房加工包装设备。',image:event.site+'/images/scene-2.webp',location:{'@type':'Place',name:event.venue,address:{'@type':'PostalAddress',streetAddress:event.address,addressLocality:'济南市',addressRegion:'山东省',addressCountry:'CN'}},organizer:{'@id':event.site+'/#organization'}}];
---
<!doctype html><html lang="zh-CN"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{`${title}｜海名·济南餐博会`}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:type" content="website"/><meta property="og:image" content={event.site+'/images/scene-2.webp'}/><meta name="theme-color" content="#153f32"/><link rel="icon" href="/favicon.ico" sizes="any"/><link rel="icon" type="image/png" href="/favicon.png"/><link rel="apple-touch-icon" href="/favicon.png"/><script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@graph':graph})}/></head><body>
<a class="skip" href="#main">跳至正文</a>
<div class="topbar"><div class="wrap"><span>山东餐饮供应链品质展</span><span>{event.date} · {event.venue}</span></div></div>
<header><div class="wrap header"><a class="brand" href="/" aria-label="济南餐博会首页"><img class="site-logo" src="/images/csce-logo.webp" alt="CSCE JN 海名餐博会·济南" width="520" height="288" fetchpriority="high"/></a><button class="menu" aria-expanded="false" aria-controls="navigation">菜单 ☰</button><nav id="navigation" aria-label="主导航"><a href="/" aria-current={path==='/'?'page':undefined}>首页</a>{nav.map((item,index)=><div class="nav-group"><div class="nav-heading"><a href={item.href} aria-current={path===item.href || item.children.some(([href])=>href.split('#')[0]===path)?'page':undefined}>{item.label}</a>{item.children.length>0 && <button class="submenu-toggle" aria-expanded="false" aria-controls={'submenu-'+index} aria-label={'展开'+item.label+'子菜单'}>⌄</button>}</div>{item.children.length>0 && <div class="submenu" id={'submenu-'+index}>{item.children.map(([href,label])=><a href={href} target={href.startsWith('http')?'_blank':undefined} rel={href.startsWith('http')?'noopener noreferrer':undefined} aria-current={path===href?'page':undefined}>{label}</a>)}</div>}</div>)}<a href="/contact/" aria-current={path==='/contact/'?'page':undefined}>联系我们</a></nav><a class="header-contact" href="/contact/">联系客服 ↗</a></div></header>
<main id="main"><slot/></main>
<section class="contact-band"><div class="wrap band-inner"><div><span class="eyebrow">LET'S MEET IN JINAN</span><h2>好食材，好伙伴。<br/>下一站，济南见。</h2></div><div><p>展位预订 · 商务合作 · 展会咨询</p><span class="big-phone">{event.phone}</span><p>直接联系客服，沟通您的参展需求。</p></div></div></section>
<footer><div class="wrap"><div class="footer-grid"><div><a class="brand" href="/">海名·济南餐博会</a><p>聚焦餐饮供应链，让选品与合作在这里发生。</p><p>{event.date}<br/>{event.venue}</p></div><div><h3>逛展指南</h3><a href="/categories/">展品范围</a><a href={event.registration} target="_blank" rel="noopener noreferrer">参观登记 ↗</a><a href="/visit/">参观指南</a><a href="/travel/">交通与住宿</a></div><div><h3>参展与合作</h3><a href="/exhibit/">参展流程</a><a href="/contact/">联系组委会</a><a href="/news/">展会动态</a><a href="/about/#faq">常见问题</a></div><div><img class="qr" src="/images/wechat.webp" alt="原官网提供的官方微信公众号二维码" width="100" height="100" loading="lazy"/><p>官方微信公众号</p></div></div><div class="legal"><span>© {event.company} · {event.office}</span><a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener noreferrer">鲁ICP备2022029830号-2</a><a href="/privacy/">隐私说明</a></div></div></footer>
<div class="mobile-contact"><a href={event.registration} target="_blank" rel="noopener noreferrer">参观登记 ↗</a><a href="/contact/">展位预订 · 联系客服 ↗</a></div>
<script>
const button=document.querySelector<HTMLButtonElement>('.menu');
const navigation=document.querySelector('#navigation');
const toggles=[...document.querySelectorAll<HTMLButtonElement>('.submenu-toggle')];
function closeGroups(){toggles.forEach(t=>{t.setAttribute('aria-expanded','false');t.closest('.nav-group')?.classList.remove('expanded');});}
button?.addEventListener('click',()=>{const open=button.getAttribute('aria-expanded')!=='true';button.setAttribute('aria-expanded',String(open));navigation?.classList.toggle('is-open',open);if(!open)closeGroups();});
toggles.forEach(toggle=>toggle.addEventListener('click',()=>{const open=toggle.getAttribute('aria-expanded')!=='true';closeGroups();toggle.setAttribute('aria-expanded',String(open));toggle.closest('.nav-group')?.classList.toggle('expanded',open);}));
document.addEventListener('keydown',e=>{if(e.key==='Escape'){closeGroups();button?.setAttribute('aria-expanded','false');navigation?.classList.remove('is-open');}});
document.addEventListener('click',e=>{if(e.target instanceof Node && !navigation?.contains(e.target))closeGroups();});
</script>
</body></html>
