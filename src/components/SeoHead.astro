---
import {siteName,defaultImage,homeFaqs} from '../data/seo';
interface Props {title:string;description:string;image?:string;}
const {title,description,image=defaultImage}=Astro.props;
const path=Astro.url.pathname;
const url=new URL(path,Astro.site!).href;
const root=Astro.site!.href;
const is404=path==='/404.html'||path==='/404/'||path==='/news/article/'||path==='/news/detail/';
const graph:Record<string,unknown>[]=[
 {'@type':'WebSite','@id':root+'#website',url:root,name:siteName,inLanguage:'zh-CN'},
 {'@type':'WebPage','@id':url+'#webpage',url,name:title,description,inLanguage:'zh-CN',isPartOf:{'@id':root+'#website'}}
];
if(path!=='/'&&!is404)graph.push({'@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'首页',item:root},{'@type':'ListItem',position:2,name:title,item:url}]});
if(path==='/'&&homeFaqs.length)graph.push({'@type':'FAQPage','@id':root+'#faq',mainEntity:homeFaqs.map(item=>({'@type':'Question',name:item.question,acceptedAnswer:{'@type':'Answer',text:item.answer}}))});

const serialize=(v:unknown)=>JSON.stringify(v).replace(/</g,'\\u003c');
---
<meta name="robots" content={is404?'noindex,follow':'index,follow,max-image-preview:large'}/>
<meta property="og:site_name" content={siteName}/><meta property="og:locale" content="zh_CN"/>
<meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={new URL(image,Astro.site!).href}/>
<script type="application/ld+json" set:html={serialize({'@context':'https://schema.org','@graph':graph})}/>
